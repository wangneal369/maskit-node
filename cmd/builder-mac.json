{
  "productName": "DataMaskit",
  "appId": "com.wangneal369.datamaskit",
  "copyright": "© 2026 wangneal369 · AGPL-3.0",
  "directories": {
    "output": "out"
  },
  "asar": true,
  "asarUnpack": [
    "node_modules/onnxruntime-node/**"
  ],
  "electronLanguages": [
    "en-US",
    "zh-CN"
  ],
  "files": [
    "public",
    "package.json",
    "node_modules/**/*",
    "!node_modules/onnxruntime-node/bin/napi-v*/win32/**",
    "!node_modules/onnxruntime-node/bin/napi-v*/linux/**"
  ],
  "extraResources": [
    {
      "from": "build/extraResources",
      "to": "extraResources"
    },
    {
      "from": "extension",
      "to": "extension"
    },
    {
      "from": "agent-bundle",
      "to": "agent-bundle"
    }
  ],
  "publish": [
    {
      "provider": "github",
      "owner": "wangneal369",
      "repo": "maskit-node",
      "releaseType": "release"
    }
  ],
  "mac": {
    "icon": "build/icons/icon.icns",
    "artifactName": "${productName}-${os}-${version}-${arch}.${ext}",
    "darkModeSupport": true,
    "hardenedRuntime": false
  }
}

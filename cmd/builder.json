{
  "productName": "DataMaskit",
  "appId": "com.wangneal369.datamaskit",
  "copyright": "© 2026 wangneal369 · AGPL-3.0",
  "directories": {
    "output": "out"
  },
  "asar": true,
  "asarUnpack": [
    "node_modules/onnxruntime-node/**"
  ],
  "electronLanguages": [
    "en-US",
    "zh-CN"
  ],
  "files": [
    "public",
    "package.json",
    "node_modules/**/*",
    "!node_modules/onnxruntime-node/bin/napi-v*/darwin/**",
    "!node_modules/onnxruntime-node/bin/napi-v*/linux/**",
    "!node_modules/onnxruntime-node/bin/napi-v*/win32/arm64/**"
  ],
  "extraResources": [
    {
      "from": "build/extraResources",
      "to": "extraResources"
    },
    {
      "from": "extension",
      "to": "extension"
    },
    {
      "from": "agent-bundle",
      "to": "agent-bundle"
    }
  ],
  "nsis": {
    "oneClick": false,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": true,
    "installerIcon": "build/icons/icon.ico",
    "uninstallerIcon": "build/icons/icon.ico",
    "installerHeaderIcon": "build/icons/icon.ico",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Data Maskit"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "wangneal369",
      "repo": "maskit-node",
      "releaseType": "release"
    }
  ],
  "win": {
    "icon": "build/icons/icon.ico",
    "artifactName": "${productName}-${os}-${version}-${arch}.${ext}",
    "target": [
      {
        "target": "nsis"
      }
    ]
  }
}

{
  "productName": "DataMaskit",
  "appId": "com.wangneal369.datamaskit",
  "copyright": "© 2026 wangneal369 · AGPL-3.0",
  "directories": {
    "output": "out"
  },
  "asar": true,
  "electronLanguages": [
    "en-US",
    "zh-CN"
  ],
  "files": [
    "public",
    "package.json",
    "node_modules/**/*"
  ],
  "extraResources": {
    "from": "build/extraResources/",
    "to": "extraResources"
  },
  "nsis": {
    "oneClick": false,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": true,
    "installerIcon": "build/icons/icon.ico",
    "uninstallerIcon": "build/icons/icon.ico",
    "installerHeaderIcon": "build/icons/icon.ico",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Data Maskit"
  },
  "publish": null,
  "win": {
    "icon": "build/icons/icon.ico",
    "artifactName": "${productName}-${os}-${version}-${arch}.${ext}",
    "target": [
      {
        "target": "nsis"
      }
    ]
  }
}
